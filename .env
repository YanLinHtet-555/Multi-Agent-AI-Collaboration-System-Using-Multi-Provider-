# ── Global fallback ──────────────────────────────────────────────────────────
# Used for any agent that does not have its own *_PROVIDER line set below.
# Options: groq | openai | anthropic | google
AI_PROVIDER=groq

# ── Per-agent provider overrides ─────────────────────────────────────────────
# Uncomment and set to route individual agents to different providers.
# Falls back to AI_PROVIDER when not set.
#
# MANAGER_PROVIDER=openai
# PLANNER_PROVIDER=groq
# RESEARCHER_PROVIDER=google
# CODER_PROVIDER=anthropic
# REVIEWER_PROVIDER=anthropic

# ── API Keys ──────────────────────────────────────────────────────────────────
# Only the key(s) for the provider(s) you are using are required.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=api_key_from_groq_here

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google AI Studio — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_key_here

# Ollama — https://ollama.com (runs locally, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_MANAGER_MODEL=llama3.1
